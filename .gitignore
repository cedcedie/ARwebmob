# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
*.g.dart.bak

# IDE
.idea/
*.iml

# Unity export output (generated, not source — see BUILD.md)
android/unityLibrary/

# Superpowers scratch workspace
.superpowers/

# Per-phase worktrees (each phase's isolated workspace)
.claude/worktrees/

# Real Firebase project config (from flutterfire configure) — every clone
# runs its own flutterfire configure rather than sharing these in git
android/app/google-services.json
firebase.json

# Service account keys (real credentials -- never commit these, see
# scripts/create-test-accounts.js's header for where they should live)
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
scripts/node_modules/

# Firebase CLI deploy cache
.firebase/

# JVM crash dumps from Gradle/Unity builds
hs_err_pid*.log
